# ───────────────────────────────────────────────
# Amunty Configuration
# ───────────────────────────────────────────────

# Port to expose (default 7000)
APP_PORT=7000

# Set to "false" to disable auth (NOT recommended for network access)
AUTH_ENABLED=true

# Pre-set admin password (otherwise auto-generated on first boot and printed to logs)
# AMUNTY_ADMIN_PASSWORD=

# Ollama URL — uncomment if Ollama is running on the host
# OLLAMA_URL=http://host.docker.internal:11434

# Debug mode — enables /api/docs and verbose SQL logging
# DEBUG=false
